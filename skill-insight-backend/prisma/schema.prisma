  created_at DateTime @default(now())

  updated_at DateTime @updatedAt

  //
  // RELATIONS
  //

  post ClassPost @relation(fields: [post_id], references: [post_id], onDelete: Cascade)

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([post_id])
  @@index([user_id])
  @@index([created_at])
  @@map("post_comments")
}

//
// ======================================================
